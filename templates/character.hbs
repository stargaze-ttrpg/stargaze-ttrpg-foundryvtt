<form class="{{cssClass}} mysheet" autocomplete="off">
  <div class="sheet">

    <header class="sheet-header">
      <div class="header-top">
        <input class="char-name" type="text" name="name" value="{{actor.name}}" placeholder="Имя">
        <input class="level" type="number" name="system.level" value="{{system.level}}">
        <input class="class" type="text" name="system.class1" value="{{system.class1}}" placeholder="Класс 1">
        <input class="class" type="text" name="system.class2" value="{{system.class2}}" placeholder="Класс 2">
        <nav class="tabs">
          <div class="tab active" data-tab="main">Основное</div>
          <div class="tab" data-tab="augments">Аугменты</div>
          <div class="tab" data-tab="dossier">Досье</div>
          <div class="tab" data-tab="abilities">Способности</div>
        </nav>
      </div>

      <div class="header-stats">
        <div class="left-stats">
          <div class="stat resource">
            <label>Здоровье</label>
            <div class="resource-values">
              <input type="number" class="current" name="system.health.value" value="{{system.health.value}}">
              <input type="number" class="max" name="system.health.max" value="{{system.health.max}}">
            </div>
          </div>

          <div class="stat resource">
            <label>Выносливость</label>
            <div class="resource-values">
              <input type="number" class="current" name="system.stamina.value" value="{{system.stamina.value}}">
              <input type="number" class="max" name="system.stamina.max" value="{{system.stamina.max}}">
            </div>
          </div>

          <div class="stat expression">
            <label>Броня</label>
            <span class="expression_total">{{system.armorTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.armor" value="{{system.armor}}">
              <span class="expression_str">база + бонусы</span>
            </div>
          </div>

          <div class="stat expression">
            <label>Инит</label>
            <span class="expression_total">{{system.initiativeTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.initiative" value="{{system.initiative}}">
              <span class="expression_str">...</span>
            </div>
          </div>

          <div class="stat expression">
            <label>Скорость</label>
            <span class="expression_total">{{system.movementSpeedTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.movementSpeed" value="{{system.movementSpeed}}">
              <span class="expression_str">...</span>
            </div>
          </div>
        </div>

        <div class="right-stats">
          <div class="stat expression">
            <label>Быстрая стрельба</label>
            <span class="expression_total">{{system.rapidFireTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.rapidFire" value="{{system.rapidFire}}">
              <span class="expression_str">...</span>
            </div>
          </div>

          <div class="stat expression">
            <label>Точная стрельба</label>
            <span class="expression_total">{{system.accurateFireTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.accurateFire" value="{{system.accurateFire}}">
              <span class="expression_str">...</span>
            </div>
          </div>

          <div class="stat expression">
            <label>Ближний бой</label>
            <span class="expression_total">{{system.meleeTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.melee" value="{{system.melee}}">
              <span class="expression_str">...</span>
            </div>
          </div>

          <div class="stat expression">
            <label>Взлом</label>
            <span class="expression_total">{{system.hackingTotal}}</span>
            <div class="expression_edit">
              <input class="expression_mod" type="number" name="system.hacking" value="{{system.hacking}}">
              <span class="expression_str">...</span>
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="main">
      <div class="attributes">

        <section class="attribute body">
          <header>
            <div class="expression">
              <span class="expression_total">{{system.attributes.body}}</span>
              <div class="expression_edit">
                <input class="expression_mod" type="number" name="system.attributes.body" value="{{system.attributes.body}}">
              </div>
            </div>
            <span class="attr-name interactive_button">Телосложение</span>
          </header>
          <div class="skills">
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.bodySaveTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.bodySave" value="{{system.skills.bodySave}}">
                  <span class="expression_str">body + bodySave</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Спасбросок</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.enduranceTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.endurance" value="{{system.skills.endurance}}">
                  <span class="expression_str">body + endurance</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Выносливость</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.athleticsTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.athletics" value="{{system.skills.athletics}}">
                  <span class="expression_str">body + athletics</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Атлетика</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.movementTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.movement" value="{{system.skills.movement}}">
                  <span class="expression_str">body + movement</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Подвижность</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.acrobaticsTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.acrobatics" value="{{system.skills.acrobatics}}">
                  <span class="expression_str">body + acrobatics</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Акробатика</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.detoxTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.detox" value="{{system.skills.detox}}">
                  <span class="expression_str">body + detox</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Детоксикация</span>
            </div>
          </div>
        </section>

        <section class="attribute nerv">
          <header>
            <div class="expression">
              <span class="expression_total">{{system.attributes.nerv}}</span>
              <div class="expression_edit">
                <input class="expression_mod" type="number" name="system.attributes.nerv" value="{{system.attributes.nerv}}">
              </div>
            </div>
            <span class="attr-name interactive_button">Нервная система</span>
          </header>
          <div class="skills">
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.nervSaveTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.nervSave" value="{{system.skills.nervSave}}">
                  <span class="expression_str">nerv + nervSave</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Спасбросок</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.reactionTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.reaction" value="{{system.skills.reaction}}">
                  <span class="expression_str">nerv + reaction</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Скорость реакции</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.accuracyTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.accuracy" value="{{system.skills.accuracy}}">
                  <span class="expression_str">nerv + accuracy</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Аккуратность</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.precisionTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.precision" value="{{system.skills.precision}}">
                  <span class="expression_str">nerv + precision</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Точность</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.alertnessTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.alertness" value="{{system.skills.alertness}}">
                  <span class="expression_str">nerv + alertness</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Внимательность</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.stealthTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.stealth" value="{{system.skills.stealth}}">
                  <span class="expression_str">nerv + stealth</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Скрытность</span>
            </div>
          </div>
        </section>

        <section class="attribute mind">
          <header>
            <div class="expression">
              <span class="expression_total">{{system.attributes.mind}}</span>
              <div class="expression_edit">
                <input class="expression_mod" type="number" name="system.attributes.mind" value="{{system.attributes.mind}}">
              </div>
            </div>
            <span class="attr-name interactive_button">Разум</span>
          </header>
          <div class="skills">
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.mindSaveTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.mindSave" value="{{system.skills.mindSave}}">
                  <span class="expression_str">mind + mindSave</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Спасбросок</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.informaticsTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.informatics" value="{{system.skills.informatics}}">
                  <span class="expression_str">mind + informatics</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Информатика</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.technicalTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.technical" value="{{system.skills.technical}}">
                  <span class="expression_str">mind + technical</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Технические знания</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.humanitarianTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.humanitarian" value="{{system.skills.humanitarian}}">
                  <span class="expression_str">mind + humanitarian</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Гуманитарные знания</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.biologicalTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.biological" value="{{system.skills.biological}}">
                  <span class="expression_str">mind + biological</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Биологические знания</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.psychologicalTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.psychological" value="{{system.skills.psychological}}">
                  <span class="expression_str">mind + psychological</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Психологические знания</span>
            </div>
          </div>
        </section>

        <section class="attribute psyc">
          <header>
            <div class="expression">
              <span class="expression_total">{{system.attributes.psyc}}</span>
              <div class="expression_edit">
                <input class="expression_mod" type="number" name="system.attributes.psyc" value="{{system.attributes.psyc}}">
              </div>
            </div>
            <span class="attr-name interactive_button">Психика</span>
          </header>
          <div class="skills">
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.psycSaveTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.psycSave" value="{{system.skills.psycSave}}">
                  <span class="expression_str">psyc + psycSave</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Спасбросок</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.empathyTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.empathy" value="{{system.skills.empathy}}">
                  <span class="expression_str">psyc + empathy</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Эмпатия</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.coolnessTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.coolness" value="{{system.skills.coolness}}">
                  <span class="expression_str">psyc + coolness</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Хладнокровие</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.persuasionTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.persuasion" value="{{system.skills.persuasion}}">
                  <span class="expression_str">psyc + persuasion</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Убедительность</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.tacticsTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.tactics" value="{{system.skills.tactics}}">
                  <span class="expression_str">psyc + tactics</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Тактика</span>
            </div>
            <div class="skill">
              <div class="expression">
                <span class="expression_total">{{system.skills.eccentricityTotal}}</span>
                <div class="expression_edit">
                  <input class="expression_mod" type="number" name="system.skills.eccentricity" value="{{system.skills.eccentricity}}">
                  <span class="expression_str">psyc + eccentricity</span>
                </div>
              </div>
              <span class="skill-name interactive_button">Эксцентричность</span>
            </div>
          </div>
        </section>

      </div>

      <section class="panel statuses">
        <h3>Состояния</h3>
        <div class="items">
          {{#each statuses}}
          <div class="item" data-item-id="{{id}}">{{name}}</div>
          {{/each}}
        </div>
      </section>

      <section class="panel properties">
        <h3>Особенности</h3>
        <div class="items">
          {{#each properties}}
          <div class="item" data-item-id="{{id}}">{{name}}</div>
          {{/each}}
        </div>
      </section>
    </div>

    <div class="inventories">
      <section class="panel inventory a inventory-ship">
        <h3>На корабле</h3>
        <div class="items">
          {{#each inventory.ship}}
          <div class="item" data-item-id="{{id}}">{{name}}</div>
          {{/each}}
        </div>
      </section>

      <section class="panel inventory b inventory-stock">
        <h3>На складе</h3>
        <div class="items">
          {{#each inventory.stock}}
          <div class="item" data-item-id="{{id}}">{{name}}</div>
          {{/each}}
        </div>
      </section>

      <section class="panel inventory c inventory-self">
        <h3>С собой</h3>
        <div class="items">
          {{#each inventory.self}}
          <div class="item" data-item-id="{{id}}">{{name}}</div>
          {{/each}}
        </div>
      </section>

      <section class="panel inventory d inventory-weapons">
        <h3>Вооружение</h3>
        <div class="items">
          {{#each inventory.weapons}}
          <div class="item" data-item-id="{{id}}">
            {{name}}
            {{#if system.description}}<br><small>{{system.description}}</small>{{/if}}
          </div>
          {{/each}}
        </div>
      </section>
    </div>

  </div>
</form>
